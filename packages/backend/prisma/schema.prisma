generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum SpoolArchiveReason {
  MANUAL
  CLOUD_REMOVED
}

enum WeightLogSource {
  PRINT
  MANUAL
  CLOUD_IMPORT
  CLOUD_SYNC
  WEIGHED
  SPOOLMAN_IMPORT
}

enum InventoryRole {
  OWNER
  EDITOR
  VIEWER
}

enum PrinterSyncMode {
  LIVE
  PERIODIC
}

enum CustomFieldKind {
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

enum WishlistStatus {
  OPEN
  ORDERED
  DONE
}

model User {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(USER)
  mustChangePassword  Boolean   @default(true)
  themeAccentColor    String?
  // Bevorzugte Ansicht und Seitengroesse der Spulenliste (leer = Standard)
  spoolView           String?
  spoolPageSize       Int?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  // Neueste Version des Aenderungsverlaufs, die dieser Nutzer schon gesehen hat (pro Konto, nicht pro Browser).
  lastSeenChangelogVersion String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  inventoryMemberships InventoryMember[]
  wishlistItemsAdded   WishlistItem[] @relation("WishlistAddedBy")
  wishlistItemsUpdated WishlistItem[] @relation("WishlistUpdatedBy")

  @@map("users")
}

// Instanzweite Wunschliste (nicht pro Lager) fuer eine Sammelbestellung: jeder eingeloggte Nutzer sieht und ergaenzt
// sie, damit klar ist, wer was braucht. userId ist bewusst optional (SetNull) und der Name eine Momentaufnahme -
// der Eintrag bleibt lesbar, auch wenn der Benutzer geloescht wird.
model WishlistItem {
  id              String         @id @default(uuid())
  title           String
  note            String?
  quantity        Int            @default(1)
  status          WishlistStatus @default(OPEN)
  // Optionaler Verweis auf einen Stammdaten-Eintrag (aus den Dropdowns im Formular) - der Titel bleibt aber
  // die massgebliche, frei editierbare Anzeige; loeschen von Hersteller/Material entfernt nur den Verweis.
  manufacturerId  String?
  manufacturer    Manufacturer?  @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  materialId      String?
  material        Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  addedByUserId   String?
  addedByUser     User?          @relation("WishlistAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  addedByName     String
  createdAt       DateTime       @default(now())
  updatedByUserId String?
  updatedByUser   User?          @relation("WishlistUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByName   String?
  updatedAt       DateTime       @updatedAt

  @@map("wishlist_items")
}

// Vom Admin definierte Zusatzfelder (Name + Typ), deren Werte Spulen dynamisch befuellen (Spool.customFields).
model CustomFieldDefinition {
  id        String          @id @default(uuid())
  name      String          @unique
  kind      CustomFieldKind
  // Pflichtfeld: eine Spule kann dann ohne Wert dafuer nicht angelegt/geaendert werden. Default false, damit
  // bestehende Felder und Spulen ohne Wert weiterhin gueltig bleiben.
  required  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@map("custom_field_definitions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EVENT
}

enum AuditArea {
  SPOOL
  MATERIAL
  MANUFACTURER
  PRINTER
  USER
  SETTINGS
  BACKUP
  INVENTORY
  WISHLIST
  CUSTOM_FIELD
}

// Aenderungsprotokoll: wer hat wann was angelegt/geaendert/geloescht. userId ist bewusst KEINE Relation und
// username eine Momentaufnahme - Eintraege bleiben lesbar, auch wenn der Benutzer geloescht/umbenannt wird
// oder eine Wiederherstellung die Benutzertabelle ersetzt. before/after enthalten nie Geheimnisse
// (Passwort-Hashes, Zugangscodes, SMTP-Passwort).
model AuditLog {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  userId      String?
  username    String
  action      AuditAction
  area        AuditArea
  entityId    String?
  // Lager, zu dem der Eintrag gehoert (ohne Fremdschluessel, damit Eintraege nach dem Loeschen lesbar bleiben).
  inventoryId   String?
  inventoryName String?
  description String
  before      Json?
  after       Json?

  @@index([inventoryId])
  @@index([createdAt])
  @@index([area])
  @@index([username])
  @@map("audit_logs")
}

// Ein Lager: ein benannter Filament-Bestand mit eigenen Spulen, Druckern und Mitgliedern (siehe docs/design/lager.md).
model Inventory {
  id        String            @id @default(uuid())
  name      String
  color     String            @default("#2F6FED")
  createdAt DateTime          @default(now())
  members   InventoryMember[]
  spools    Spool[]
  printers  Printer[]
  bambuConnection BambuConnection?

  @@map("inventories")
}

// Gemerkte Verbindung eines Lagers zur Bambu-Cloud (Opt-in, hoechstens eine je Lager). Das Zugangs-Token ist mit einem Schluessel aus
// SESSION_SECRET verschluesselt (wie das SMTP-Passwort) und verlaesst den Server nie. Wird mit dem Lager geloescht.
model BambuConnection {
  id              String    @id @default(uuid())
  inventoryId     String    @unique
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  region          String
  tokenEncrypted  String
  // Ablauf laut Token (nur zur Anzeige), sonst leer
  tokenExpiresAt  DateTime?
  connectedByName String
  connectedAt     DateTime  @default(now())
  lastSyncAt      DateTime?
  lastSyncSummary String?
  // Letzter Versuch (auch fehlgeschlagen), ob er automatisch lief, und der Fehler des letzten Versuchs
  lastAttemptAt   DateTime?
  lastSyncAuto    Boolean   @default(false)
  lastSyncError   String?

  @@map("bambu_connections")
}

model InventoryMember {
  id          String        @id @default(uuid())
  inventoryId String
  inventory   Inventory     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        InventoryRole
  createdAt   DateTime      @default(now())

  @@unique([inventoryId, userId])
  @@index([userId])
  @@map("inventory_members")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

// manufacturerId = null: allgemeines Material, gilt fuer jeden Hersteller. Sonst ist es ein Produkt
// dieses Herstellers (z.B. "PLA Basic" von Bambu Lab) mit dessen Richttemperaturen.
model Material {
  id             String        @id @default(uuid())
  name           String
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  printTempMinC  Int
  printTempMaxC  Int
  bedTempC       Int?
  // Oberes Ende eines Bett-Temperatur-Bereichs; null = weiterhin ein Einzelwert (bedTempC), wie zuvor.
  bedTempMaxC    Int?
  // Fuer die ungefaehre Restlaengen-Anzeige der Spule (g/cm3); optional, typische Herstellerangabe.
  densityGCm3    Float?
  // Durchmesser des Filaments in mm (fast immer 1,75, selten 2,85) - fuer die Restlaengen-Naeherung der Spule.
  filamentDiameterMm Float @default(1.75)
  spools         Spool[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime      @default(now())

  @@unique([manufacturerId, name])
  @@map("materials")
}

model Manufacturer {
  id        String     @id @default(uuid())
  name      String     @unique
  spools    Spool[]
  materials Material[]
  wishlistItems WishlistItem[]
  defaultForSettings Settings[]
  createdAt DateTime   @default(now())

  @@map("manufacturers")
}

model Spool {
  id                  String     @id @default(uuid())
  materialId          String
  material            Material   @relation(fields: [materialId], references: [id])
  manufacturerId      String
  manufacturer        Manufacturer @relation(fields: [manufacturerId], references: [id])
  colorName           String
  colorHex            String?
  // Zweite Farbe fuer zweifarbiges Filament (z.B. Bambu Dual-Color); null = einfarbig.
  colorHex2           String?
  initialWeightG      Int
  remainingWeightG    Int
  // Leergewicht der Spule ohne Filament (g); optional, ermoeglicht "Wiegen": Restgewicht = gemessenes Gewicht - Tara.
  tareWeightG         Int?
  photoUrl            String?
  // Freie Notiz (z.B. Charge, Eindruck beim Drucken).
  note                String?
  // Werte der Admin-definierten Zusatzfelder, Schluessel = CustomFieldDefinition.id. Nie blind vom Client
  // uebernommen - die Route validiert jeden Schluessel/Wert gegen die bekannten Definitionen (siehe customFields.ts).
  customFields        Json       @default("{}")
  purchasePriceCents  Int?
  purchasedAt         DateTime?
  location            String?
  // Optional nur wegen der Datenuebernahme per "db push"; ensureDefaultInventory() fuellt es, der Code schreibt nie ohne Lager.
  inventoryId         String?
  inventory           Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  // Spulen-ID der Bambu-Cloud beim Import (der Import erkennt damit schon importierte Spulen und aktualisiert deren Restgewicht).
  // Bewusst KEINE Datenbank-Eindeutigkeit (@@unique): "prisma db push" verlangt fuer eine neue Eindeutigkeitsregel auf einer
  // gefuellten Tabelle eine Freigabe (--accept-data-loss), und das Update-Skript bricht dann ab. Die Eindeutigkeit stellt der
  // Import im Code sicher (Pruefung innerhalb der Transaktion).
  bambuCloudId        String?
  // Spulen-ID aus Spoolman beim Import (erkennt schon importierte Spulen je Lager, wie bambuCloudId). Bewusst
  // KEINE Datenbank-Eindeutigkeit, aus demselben Grund wie bei bambuCloudId (siehe dort).
  spoolmanId          String?
  // null = noch ungeoeffnet/unbenutzt (z.B. frisch manuell angelegt, noch nie gewogen/verbraucht/im AMS erkannt).
  // Gesetzt bei: Cloud-/Spoolman-Import (dem Drucker/Dienst bereits bekannt), erster echter Gewichtsaenderung
  // (Druck, Wiegen, manuelle Bearbeitung), erster AMS-Zuordnung, oder manuell ueber "Als geoeffnet markieren".
  openedAt            DateTime?
  // Archivierte Spulen zaehlen im Verbrauch weiter mit, nicht mehr im Restbestand.
  archivedAt          DateTime?
  archiveReason       SpoolArchiveReason?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  printJobs           PrintJob[]
  amsSlotAssignments  AmsSlotAssignment[]
  weightLogs          SpoolWeightLog[]

  @@index([materialId])
  @@index([manufacturerId])
  @@index([inventoryId])
  @@index([inventoryId, bambuCloudId])
  @@index([inventoryId, spoolmanId])
  @@index([inventoryId, archivedAt])
  @@index([inventoryId, openedAt])
  @@map("spools")
}

// Verlauf des Restgewichts: Grundlage der Statistik nach Tag/Woche/Monat/Jahr. Wird nur vom Server geschrieben.
model SpoolWeightLog {
  id          String          @id @default(uuid())
  spoolId     String
  spool       Spool           @relation(fields: [spoolId], references: [id], onDelete: Cascade)
  // Lager zum Zeitpunkt der Aenderung (Momentaufnahme, ohne Fremdschluessel)
  inventoryId String?
  at          DateTime        @default(now())
  // positiv = verbraucht, negativ = Gewicht erhoeht
  deltaG      Int
  remainingG  Int
  source      WeightLogSource

  @@index([inventoryId, at])
  @@index([spoolId, at])
  @@map("spool_weight_logs")
}

model Printer {
  id                  String              @id @default(uuid())
  name                String
  ipAddress           String
  serialNumber        String              @unique
  accessCode          String
  syncMode            PrinterSyncMode     @default(PERIODIC)
  syncIntervalSeconds Int                 @default(60)
  inventoryId         String?
  inventory           Inventory?          @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  createdAt           DateTime            @default(now())
  printJobs           PrintJob[]
  amsSlots            AmsSlotAssignment[]
  // Zwischenstand der automatischen Verbrauchserfassung (printJobTracker.ts), in der DB statt nur im Arbeitsspeicher,
  // damit ein Server-Neustart mitten im Druck die Erkennung fuer den laufenden Auftrag nicht verliert.
  lastKnownPrintState String?
  activeJobName        String?
  activeJobStartedAt   DateTime?

  @@index([inventoryId])
  @@map("printers")
}

model AmsSlotAssignment {
  id        String    @id @default(uuid())
  printerId String
  printer   Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  slotIndex Int
  spoolId   String?
  // Loeschen der zugeordneten Spule leert das Fach (SetNull), statt das Loeschen der Spule zu verhindern.
  spool     Spool?    @relation(fields: [spoolId], references: [id], onDelete: SetNull)
  // Kalibrierung beim Zuordnen: Restgewicht/AMS-Fuellstand zu diesem Zeitpunkt, Basis der Verbrauchsberechnung
  assignedAt          DateTime?
  baselineRemainingG  Int?
  baselineRemainPercent Float?

  @@unique([printerId, slotIndex])
  @@map("ams_slot_assignments")
}

model PrintJob {
  id            String    @id @default(uuid())
  printerId     String
  // Loeschen von Drucker oder Spule raeumt die zugehoerigen Auftraege mit auf (wie beim Gewichtsverlauf einer Spule).
  printer       Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  spoolId       String
  spool         Spool     @relation(fields: [spoolId], references: [id], onDelete: Cascade)
  name          String
  filamentUsedG Float
  costCents     Int?
  succeeded     Boolean   @default(true)
  startedAt     DateTime
  finishedAt    DateTime?

  @@index([printerId])
  @@index([spoolId])
  @@map("print_jobs")
}

model Settings {
  id                                 Int      @id @default(1)
  photoUploadEnabled                 Boolean  @default(true)
  defaultPrinterSyncIntervalSeconds  Int      @default(60)
  smtpHost                           String?
  smtpPort                           Int?
  smtpSecure                         Boolean  @default(true)
  smtpUsername                       String?
  smtpPasswordEncrypted              String?
  smtpFromAddress                    String?
  backupFolderPath                   String   @default("/data/backups")
  backupEnabled                      Boolean  @default(true)
  // Wie viele Sicherungen aufbewahrt werden; aeltere werden nach jeder regulaeren Sicherung geloescht.
  backupRetentionCount               Int      @default(14)
  // Wie viele Monate das Aenderungsprotokoll aufbewahrt wird; 0 = unbegrenzt.
  auditRetentionMonths               Int      @default(12)
  // Automatischer Abgleich gemerkter Bambu-Verbindungen in Minuten, 0 = aus
  bambuAutoSyncMinutes               Int      @default(0)
  // Stand der mitgelieferten Hersteller-/Material-Vorlagen, die zuletzt eingespielt wurden.
  catalogVersion                     Int      @default(0)
  // Wie lange eine Anmeldung gueltig bleibt, bevor sie sich neu anmelden muessen.
  sessionExpiryDays                  Int      @default(30)
  // Reserviert fuer spaeter: Freischaltung per Lizenzschluessel. Aktuell ungenutzt.
  licenseKey                         String?
  // Einmaliger Nachtrag beim Update auf 0.22.0 (openedAt): true = schon erledigt, nie erneut ausfuehren - sonst
  // wuerden auch echte neue ungeoeffnete Spulen faelschlich als "schon immer geoeffnet" markiert. Siehe openedAtBackfill.ts.
  openedAtBackfilled                 Boolean  @default(false)
  // Vorbelegter Hersteller im "Neue Spule"-Formular; null = kein Standard. Loeschen des Herstellers raeumt
  // dieses Feld nur auf (SetNull), verhindert nicht das Loeschen.
  defaultManufacturerId               String?
  defaultManufacturer                 Manufacturer? @relation(fields: [defaultManufacturerId], references: [id], onDelete: SetNull)
  updatedAt                          DateTime @updatedAt

  @@map("settings")
}
