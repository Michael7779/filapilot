# Auf der Synology in eine Datei ".env" (ohne .example) neben docker-compose.yml kopieren
# und die Werte ausfuellen. Diese Datei selbst nie mit echten Werten committen.
#
# POSTGRES_PASSWORD und SESSION_SECRET erzeugen mit:
#   openssl rand -hex 32
# WICHTIG: -hex verwenden, nicht -base64 - Base64 kann "/" oder "+" erzeugen, das POSTGRES_PASSWORD
# landet direkt in der Datenbank-Verbindungs-URL und ein "/" darin macht die URL ungueltig.

POSTGRES_PASSWORD=
SESSION_SECRET=

# Tatsaechlich erreichbare Adresse, NICHT "localhost" (die App wird von anderen Geraeten im
# Netzwerk aufgerufen) - z.B. http://192.168.1.50:8090 oder http://meine-synology.example.com:8090
FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080
